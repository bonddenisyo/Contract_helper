# Fill in at least one provider. Leave the rest empty.
# Order in which providers are tried (first available wins, next is used if it fails):
PROVIDER_ORDER=cloudflare,gemini,groq,ollama

# Cloudflare Workers AI (does not train on your data)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# Google Gemini (free tier may be used to improve Google's products)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama, self-hosted (v2). Example: http://localhost:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
